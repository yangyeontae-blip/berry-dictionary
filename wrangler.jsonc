{
  "name": "berry-dictionary",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  // 화면은 dist 정적 파일. /api/* 만 Worker가 먼저 받는다(표준국어대사전 연결).
  "assets": {"directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"]},
  // 표준국어대사전 키를 가진 berry-dict Worker를 불러 쓴다(worker/index.ts 참고)
  "services": [{"binding": "DICT", "service": "berry-dict"}]
}
